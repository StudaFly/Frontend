# Same origin: Vite proxies /api to the backend (API_PROXY_TARGET, default http://localhost:8080)
VITE_API_URL=/api/v1
VITE_STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
VITE_APP_ENV=development
VITE_APP_NAME=StudaFly

# OAuth
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_SERVICES_ID=
VITE_APPLE_REDIRECT_URI=

# Optional: public host of a Cloudflare Tunnel to the dev server (e.g. dev.studafly.com)
DEV_PUBLIC_HOST=
